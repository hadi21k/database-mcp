{
  "name": "database-mcp",
  "version": "2.0.0",
  "description": "Database MCP Server - A secure, read-only Model Context Protocol server for SQL Server and PostgreSQL",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "database-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel38/database-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sql-server",
    "postgresql",
    "postgres",
    "database",
    "cursor",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mssql": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  }
}
